# SkillVerse Environment Template (Phase 44F Least-Privilege & Neon PostgreSQL)
# Copy this file to '.env' or '.env.local' and supply secure staging/production credentials.
# NEVER commit real credentials, database passwords, or OAuth secrets to version control.

# =============================================================================
# 1. Database Connections (Neon Serverless PostgreSQL — Least-Privilege Role Separation)
# =============================================================================
# Application Runtime Connection (REQUIRED in Production):
# Must connect through Neon pooled endpoint (PgBouncer) as least-privilege role 'skillverse_app'.
# Administrative / owner roles (e.g. 'neondb_owner') are strictly rejected in production runtime.
APP_DATABASE_URL="postgresql://skillverse_app:YOUR_STAGING_APP_PASSWORD@ep-staging-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Migration Runner Connection (REQUIRED in Production for Drizzle Kit / deploy scripts):
# Must connect through direct (unpooled) endpoint as schema deployment role 'skillverse_migrator'.
# Never reuse runtime application credentials for migrations.
MIGRATOR_DATABASE_URL="postgresql://skillverse_migrator:YOUR_STAGING_MIGRATOR_PASSWORD@ep-staging-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Staging verification indicator (set to "true" only after independent branch verification):
NEON_DISPOSABLE_BRANCH_VERIFIED="false"
NEON_BRANCH="staging-phase44-gate"

# Development Fallbacks (Permitted ONLY in NODE_ENV !== 'production'):
# In development mode, lib/drizzle.ts will check APP_DATABASE_URL || DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/postgres"

# =============================================================================
# 2. Authentication (Better Auth & GitHub OAuth)
# =============================================================================
# Cryptographically secure random secret generated with CSPRNG (crypto.randomBytes(32)):
# Production startup rejects missing, short (<32 chars), or heuristic placeholder secrets.
BETTER_AUTH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_32_BYTE_STRING"
BETTER_AUTH_URL="https://staging.skillverse.dev"
NEXT_PUBLIC_APP_URL="https://staging.skillverse.dev"

# GitHub OAuth App credentials (staging app registered with GitHub OAuth):
GITHUB_CLIENT_ID="gh_client_id_placeholder"
GITHUB_CLIENT_SECRET="gh_client_secret_placeholder"

# Demo authentication switch (MUST be false or unset in production environments):
ENABLE_DEMO_AUTH="false"

# =============================================================================
# 3. AI Intelligence & External Services
# =============================================================================
HUGGINGFACE_API_KEY="hf_placeholder"
HUGGINGFACE_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
GITHUB_ACCESS_TOKEN="ghp_placeholder_token_for_scans"

# =============================================================================
# 4. Legacy Supabase Fallback Compatibility (Deprecated — Set for bridge only)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://placeholder.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder_anon_key"
